---
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
  buttonText: string;
  buttonHref: string;
}

const { title, description, buttonText, buttonHref } = Astro.props;
---

<section class="cta">
  <h2>{title}</h2>
  <p>{description}</p>
  <Button href={buttonHref}>{buttonText}</Button>
</section>
