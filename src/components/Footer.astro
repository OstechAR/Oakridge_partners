---
interface Props {
  full?: boolean;
}

const { full = false } = Astro.props;
const year = new Date().getFullYear();
---

{
  full ? (
    <footer>
      <h3>Oakridge Partners</h3>
      <br />
      <p>
        Some links on this website may be affiliate links. Oakridge Partners
        may receive compensation if users choose to explore certain products
        or services through partner links.
      </p>
      <br />
      <a href="privacy.html">Privacy Policy</a>
      <a href="terms.html">Terms</a>
      <a href="disclosure.html">Affiliate Disclosure</a>
      <p style="margin-top:20px;">© {year} Oakridge Partners. All rights reserved.</p>
    </footer>
  ) : (
    <footer>Oakridge Partners © {year}</footer>
  )
}
