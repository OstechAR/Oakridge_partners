---
import { withBase } from '../utils/site';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
---

<header>
  <div class="logo">Oakridge Partners</div>

  <nav>
    {
      home ? (
        <>
          <a href="#services">Financial Topics</a>
          <a href="#how">How It Works</a>
          <a href="#about">About</a>
        </>
      ) : (
        <>
          <a href={withBase('index.html')}>Home</a>
          <a href={withBase('questionnaire.html')}>Find My Options</a>
        </>
      )
    }
  </nav>
</header>
