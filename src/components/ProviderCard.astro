---
import type { CollectionEntry } from 'astro:content';

interface Props {
  provider: CollectionEntry<'providers'>;
}

const { provider } = Astro.props;
---

<div class="small-card">
  <h3>{provider.data.name}</h3>
  <p>{provider.data.summary}</p>
  <a href={provider.data.website} target="_blank" rel="noopener noreferrer">
    Visit Website →
  </a>
</div>
