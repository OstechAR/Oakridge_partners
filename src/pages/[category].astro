---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { withBase } from '../utils/site';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

interface Props {
  category: CollectionEntry<'categories'>;
}

const { category } = Astro.props;

const relatedOffers = (await getCollection('marketplace'))
  .filter((offer) => offer.data.category === category.id && !offer.data.draft)
  .sort((a, b) => b.data.priority - a.data.priority);

const offerProviders = await Promise.all(
  relatedOffers.map((offer) => getEntry(offer.data.provider))
);

const relatedArticles = (await getCollection('articles')).filter(
  (article) => article.data.category === category.id && !article.data.draft
);
---

<BaseLayout
  title={`${category.data.heroTitle} | Oakridge Partners`}
  description={category.data.heroDescription}
>
  <div class="container">
    <Hero title={category.data.heroTitle} description={category.data.heroDescription} />

    {
      category.data.sections.map((section) => (
        <section class="card">
          <h2>{section.heading}</h2>

          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}

          {section.grid && (
            <div class="factors">
              {section.grid.map((item) => (
                <div class="factor">
                  <h3>{item.heading}</h3>
                  <p>{item.text}</p>
                </div>
              ))}
            </div>
          )}

          {section.list && (
            <ul style="padding-left:25px;">
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}

          {section.faq && (
            <>
              {section.faq.map((item) => (
                <>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                  <br />
                </>
              ))}
            </>
          )}
        </section>
      ))
    }

    {
      relatedOffers.length > 0 && (
        <section class="card">
          <h2>Partner Options To Explore</h2>
          <p class="section-subtitle">
            These offers are pulled automatically from the marketplace
            collection for this category.
          </p>
          <div class="cards">
            {relatedOffers.map((offer, i) => (
              <div class="small-card offer-card">
                {offer.data.featured && <span class="featured-badge">Featured</span>}
                {offerProviders[i] && (
                  <span class="provider-name">{offerProviders[i]!.data.name}</span>
                )}
                <h3>{offer.data.title}</h3>
                <p>{offer.data.summary}</p>
                <a
                  href={offer.data.affiliateUrl}
                  class="button"
                  target="_blank"
                  rel="sponsored noopener noreferrer"
                >
                  {offer.data.buttonText}
                </a>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      relatedArticles.length > 0 && (
        <section class="card">
          <h2>Related Articles</h2>
          <div class="cards">
            {relatedArticles.map((article) => (
              <div class="small-card">
                <h3>
                  <a href={withBase(`articles/${article.id}.html`)}>{article.data.title}</a>
                </h3>
                <p>{article.data.description}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <CTA
      title={category.data.ctaTitle}
      description={category.data.ctaDescription}
      buttonText="Start Questionnaire"
      buttonHref={withBase('questionnaire.html')}
    />

    {category.data.disclaimer ? (
      <Disclaimer>{category.data.disclaimer}</Disclaimer>
    ) : (
      <Disclaimer />
    )}
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1000px;
    margin: auto;
    padding: 60px 25px;
  }

  .cta {
    margin-top: 40px;
  }

  .disclaimer {
    margin-top: 30px;
  }
</style>
