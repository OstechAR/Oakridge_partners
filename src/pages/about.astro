---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/site';
---

<BaseLayout
  title="About Oakridge Partners | Financial Education Platform"
  description="Learn about Oakridge Partners, a Canadian financial education and referral platform helping people understand credit, loans, banking, and insurance options."
>
  <div class="container">
    <section class="hero">
      <h1>About Oakridge Partners</h1>
      <p>
        Making financial information easier to understand through education,
        resources, and transparent partnerships.
      </p>
    </section>

    <section class="card">
      <h2>Our Mission</h2>
      <p>
        Financial decisions can feel overwhelming. Many people struggle to
        understand credit, loans, banking products, and insurance options
        because information is often scattered or difficult to compare.
      </p>
      <br />
      <p>
        Oakridge Partners exists to organize financial education resources
        into a simpler experience, helping Canadians better understand
        topics that may affect their financial decisions.
      </p>
    </section>

    <section class="card">
      <h2>How Oakridge Partners Works</h2>
      <div class="cards">
        <div class="small-card">
          <h3>1. Education First</h3>
          <p>
            We explain financial concepts in simple terms so users can build
            knowledge before exploring services.
          </p>
        </div>

        <div class="small-card">
          <h3>2. Resource Discovery</h3>
          <p>
            Users can explore information related to their interests through
            educational pathways.
          </p>
        </div>

        <div class="small-card">
          <h3>3. Partner Connections</h3>
          <p>
            When appropriate, users may be directed to third-party services
            that may be relevant to their interests.
          </p>
        </div>
      </div>
    </section>

    <section class="card">
      <h2>What We Do Not Do</h2>
      <p>
        Oakridge Partners is not a bank, lender, insurance company, credit
        bureau, or financial advisory firm.
      </p>
      <br />
      <p>We do not:</p>
      <ul style="padding-left:25px;">
        <li>Provide personalized financial advice.</li>
        <li>Guarantee approval for financial products.</li>
        <li>Make decisions on behalf of financial institutions.</li>
        <li>Replace professional financial guidance.</li>
      </ul>
    </section>

    <section class="card">
      <h2>Our Approach To Partnerships</h2>
      <p>
        We believe financial resources should be presented transparently.
        When users choose to explore certain products or services through
        partner links, Oakridge Partners may receive compensation.
      </p>
      <br />
      <p>
        Compensation helps support the operation of the platform and does
        not change our commitment to providing educational information.
      </p>
    </section>

    <section class="card">
      <h2>Who We Help</h2>
      <div class="cards">
        <div class="small-card">
          <h3>People Building Financial Knowledge</h3>
          <p>
            Individuals looking to better understand financial topics and
            terminology.
          </p>
        </div>

        <div class="small-card">
          <h3>People Comparing Options</h3>
          <p>Individuals researching products and services before making decisions.</p>
        </div>

        <div class="small-card">
          <h3>People Improving Their Financial Awareness</h3>
          <p>Individuals who want to learn more about managing financial choices.</p>
        </div>
      </div>
    </section>

    <section class="cta">
      <h2>Ready To Explore Your Options?</h2>
      <p>Start with a short questionnaire and discover resources related to your goals.</p>
      <a href={withBase('questionnaire.html')} class="button">Start Questionnaire</a>
    </section>

    <section class="disclaimer">
      <strong>Affiliate Disclosure:</strong>
      <br /><br />
      Oakridge Partners may receive compensation from certain partners if
      users choose to explore products or services through links on this
      website. These partnerships help support the platform.
      <br /><br />
      Oakridge Partners provides educational information only. Information
      provided on this website should not be considered financial advice or
      a recommendation to purchase any financial product.
    </section>
  </div>
</BaseLayout>
