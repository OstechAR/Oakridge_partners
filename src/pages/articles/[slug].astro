---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { withBase } from '../../utils/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const categoryHref = withBase(`${article.data.category}.html`);
---

<BaseLayout
  title={`${article.data.title} | Oakridge Partners`}
  description={article.data.description}
>
  <div class="container">
    <Hero title={article.data.title} description={article.data.description} />

    <section class="card">
      <Content />
    </section>

    <CTA
      title="Want Resources Based On Your Goals?"
      description="Answer a few questions and explore financial education resources related to your situation."
      buttonText="Start Questionnaire"
      buttonHref={withBase('questionnaire.html')}
    />

    <p style="margin-top:25px;">
      <a href={categoryHref}>← Back to {article.data.category} resources</a>
    </p>

    <Disclaimer />
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1000px;
    margin: auto;
    padding: 60px 25px;
  }

  .cta {
    margin-top: 40px;
  }

  .disclaimer {
    margin-top: 30px;
  }
</style>
