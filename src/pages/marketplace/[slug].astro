---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { withBase } from '../../utils/site';

export async function getStaticPaths() {
  const offers = await getCollection('marketplace');
  return offers.map((offer) => ({
    params: { slug: offer.id },
    props: { offer },
  }));
}

interface Props {
  offer: CollectionEntry<'marketplace'>;
}

const { offer } = Astro.props;
const provider = await getEntry(offer.data.provider);
const { Content } = await render(offer);
const categoryHref = withBase(`${offer.data.category}.html`);
---

<BaseLayout title={`${offer.data.title} | Oakridge Partners`} description={offer.data.summary}>
  <div class="container">
    <Hero title={offer.data.title} description={offer.data.summary} />

    <section class="card">
      {provider && <p><strong>Provider:</strong> {provider.data.name}</p>}
      <p><strong>Offer type:</strong> {offer.data.offerType}</p>
      {
        offer.data.eligibility.length > 0 && (
          <>
            <p>
              <strong>Eligibility:</strong>
            </p>
            <ul style="padding-left:25px;">
              {offer.data.eligibility.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        )
      }
      <Content />
      <br />
      <a
        href={offer.data.affiliateUrl}
        class="button"
        target="_blank"
        rel="sponsored noopener noreferrer"
      >
        {offer.data.buttonText}
      </a>
    </section>

    <p style="margin-top:25px;">
      <a href={categoryHref}>← Back to {offer.data.category} resources</a>
    </p>

    <Disclaimer>
      Oakridge Partners may receive compensation if you choose to explore
      this offer through the link above. This is not financial advice and
      does not guarantee approval.
    </Disclaimer>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1000px;
    margin: auto;
    padding: 60px 25px;
  }

  .disclaimer {
    margin-top: 30px;
  }
</style>
