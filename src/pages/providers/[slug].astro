---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { withBase } from '../../utils/site';

export async function getStaticPaths() {
  const providers = await getCollection('providers');
  const marketplace = await getCollection('marketplace');

  return providers.map((provider) => ({
    params: { slug: provider.id },
    props: {
      provider,
      offers: marketplace.filter((offer) => offer.data.provider.id === provider.id),
    },
  }));
}

interface Props {
  provider: CollectionEntry<'providers'>;
  offers: CollectionEntry<'marketplace'>[];
}

const { provider, offers } = Astro.props;
const { Content } = await render(provider);
---

<BaseLayout
  title={`${provider.data.name} | Oakridge Partners`}
  description={provider.data.summary}
>
  <div class="container">
    <Hero title={provider.data.name} description={provider.data.summary} />

    <section class="card">
      <Content />
      <br />
      <a href={provider.data.website} class="button" target="_blank" rel="noopener noreferrer">
        Visit {provider.data.name} →
      </a>
    </section>

    {
      offers.length > 0 && (
        <section class="card">
          <h2>Offers From {provider.data.name}</h2>
          <div class="cards">
            {offers.map((offer) => (
              <div class="small-card">
                <h3>
                  <a href={withBase(`marketplace/${offer.id}.html`)}>{offer.data.title}</a>
                </h3>
                <p>{offer.data.summary}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1000px;
    margin: auto;
    padding: 60px 25px;
  }
</style>
