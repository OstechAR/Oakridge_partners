---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Questionnaire from '../components/Questionnaire.astro';

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Financial Questionnaire | Oakridge Partners"
  description="Answer a few questions to discover financial education resources related to credit, loans, banking, and insurance."
>
  <div class="container">
    <div class="card">
      <h1>Find Your Financial Resources</h1>
      <p class="intro">
        Answer three quick questions so we can show you educational
        resources related to your goals.
      </p>

      <Questionnaire categories={categories} />

      <div class="disclaimer">
        <strong>Important:</strong>
        Oakridge Partners provides educational information and referral resources.
        We do not provide financial advice, guarantee approval, or make decisions
        on behalf of financial institutions.
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
    margin: 60px auto;
    padding: 0 25px;
  }

  h1 {
    font-size: 42px;
    color: #0f172a;
    margin-bottom: 15px;
  }

  .intro {
    color: #475569;
    margin-bottom: 35px;
  }
</style>
