---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/site';

// Build a static dataset at build time from the content collections.
// Adding a new marketplace/article/category markdown file and rebuilding
// is all that's needed for it to show up here — no code changes.
const categories = await getCollection('categories');
const marketplace = await getCollection('marketplace');
const articles = await getCollection('articles');

const categoryData = Object.fromEntries(
  categories.map((c) => [
    c.id,
    {
      title: c.data.title,
      summary: c.data.questionnaireSummary,
    },
  ])
);

const marketplaceData = marketplace
  .filter((m) => !m.data.draft)
  .sort((a, b) => b.data.priority - a.data.priority)
  .map((m) => ({
    category: m.data.category,
    title: m.data.title,
    summary: m.data.summary,
    buttonText: m.data.buttonText,
    affiliateUrl: m.data.affiliateUrl,
    featured: m.data.featured,
  }));

const articleData = articles
  .filter((a) => !a.data.draft)
  .sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0))
  .map((a) => ({
    category: a.data.category,
    title: a.data.title,
    description: a.data.description,
    href: withBase(`articles/${a.id}.html`),
  }));

const dataset = { categories: categoryData, marketplace: marketplaceData, articles: articleData };
const questionnaireHref = withBase('questionnaire.html');
const indexHref = withBase('index.html');
---

<BaseLayout
  title="Your Financial Resources | Oakridge Partners"
  description="Explore financial education resources based on your goals with Oakridge Partners."
>
  <div class="container">
    <div class="hero">
      <h1 id="headline">Your Financial Learning Profile</h1>
      <p id="summary">
        Based on your answers, we have selected resources that may help you
        better understand your options.
      </p>
    </div>

    <div class="card">
      <h2>Your Focus</h2>
      <h3 id="topic">Loading...</h3>
      <p id="goal"></p>
    </div>

    <div class="card" id="offers-card" style="display:none;">
      <h2>Partner Options To Explore</h2>
      <div id="offers"></div>
    </div>

    <div class="card">
      <h2>Recommended Resources To Explore</h2>
      <div id="resources"></div>
    </div>

    <div class="card">
      <h2>Next Steps</h2>
      <p>
        Continue learning about your selected topic, review available
        resources, and decide what information is most useful for your
        situation.
      </p>
      <br />
      <a href={indexHref} class="button">Return Home</a>
      <a href={questionnaireHref} class="button secondary">Restart Questionnaire</a>
    </div>

    <div class="disclaimer">
      <strong>Disclaimer:</strong>
      Oakridge Partners provides educational information and referral
      resources. Results are based only on the information provided in this
      questionnaire and should not be considered financial advice or a
      recommendation to purchase any financial product.
    </div>
  </div>

  <script type="application/json" id="oakridge-dataset" set:html={JSON.stringify(dataset)} />

  <script define:vars={{ questionnaireHref }}>
    const dataset = JSON.parse(document.getElementById('oakridge-dataset').textContent);

    const topicElement = document.getElementById('topic');
    const goalElement = document.getElementById('goal');
    const resourcesElement = document.getElementById('resources');
    const offersCard = document.getElementById('offers-card');
    const offersElement = document.getElementById('offers');

    const answers = JSON.parse(localStorage.getItem('oakridgeAnswers'));

    if (!answers) {
      document.getElementById('headline').innerText = "Let's Find Your Resources";
      document.getElementById('summary').innerText =
        'Complete the questionnaire first so we can understand what financial topics interest you.';
      topicElement.innerHTML = `<a href="${questionnaireHref}">Start Questionnaire</a>`;
    } else {
      const topicKey = dataset.categories[answers.topic] ? answers.topic : Object.keys(dataset.categories)[0];
      const profile = dataset.categories[topicKey];

      topicElement.innerText = profile.title;
      goalElement.innerText = profile.summary;

      const matchingOffers = dataset.marketplace.filter((offer) => offer.category === topicKey);
      const matchingArticles = dataset.articles.filter((article) => article.category === topicKey);

      if (matchingOffers.length > 0) {
        offersCard.style.display = 'block';
        matchingOffers.forEach((offer) => {
          const div = document.createElement('div');
          div.className = 'resource';
          div.innerHTML = `
            <h3>${offer.title}</h3>
            <p>${offer.summary}</p>
            <a class="button" href="${offer.affiliateUrl}" target="_blank" rel="sponsored noopener noreferrer">${offer.buttonText}</a>
          `;
          offersElement.appendChild(div);
        });
      }

      if (matchingArticles.length > 0) {
        matchingArticles.forEach((article) => {
          const div = document.createElement('div');
          div.className = 'resource';
          div.innerHTML = `
            <h3><a href="${article.href}">${article.title}</a></h3>
            <p>${article.description}</p>
          `;
          resourcesElement.appendChild(div);
        });
      } else {
        resourcesElement.innerHTML =
          '<p class="empty-state">No articles found for this topic yet — check back soon.</p>';
      }
    }
  </script>
</BaseLayout>

<style>
  .container {
    max-width: 900px;
    margin: 60px auto;
    padding: 0 25px;
  }

  .hero {
    background: #eff6ff;
    padding: 40px;
    border-radius: 20px;
    margin-bottom: 35px;
  }

  .hero h1 {
    font-size: 42px;
    margin-bottom: 15px;
    color: #0f172a;
  }

  @media (max-width: 700px) {
    .hero h1 {
      font-size: 34px;
    }
  }
</style>
